# The container hosts an emulator, not the worker confinement boundary.
FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
RUN apt-get update && apt-get install -y --no-install-recommends qemu-system-x86=1:10.0.13+ds-0+deb13u1 qemu-utils=1:10.0.13+ds-0+deb13u1 genisoimage=9:1.1.11-4 ca-certificates=20250419 && rm -rf /var/lib/apt/lists/*
ENTRYPOINT ["qemu-system-x86_64"]
