{
  "namespace": "dev",
  "group": "dev-team",
  "supervisor": {
    "principal_id": "sup-dev",
    "kind": "human",
    "auth_kind": "spiffe",
    "issuer": "cardea.internal",
    "subject": "spiffe://cardea.internal/supervisor/dev-team"
  },
  "timezone": "UTC",
  "repository": "cardea",
  "default_branch": "main",
  "product": {
    "goals": "Replace these placeholder goals with your product's own.\n- Who the product is for, and the problem it solves for them.\n- The outcomes that matter most this quarter, in priority order.\n- What a first-time user must be able to do without help.",
    "non_goals": "- Features the team must not build, even if asked.\n- Platforms, integrations or audiences out of scope for now."
  },
  "harness": "claude",
  "model": "claude-sonnet-4-5",
  "developers": 2,
  "credentials": {
    "author": "github",
    "reviewer": "github-reviewer",
    "expires_on": "2027-01-31",
    "reviewer_login": "reviewer-login.example"
  },
  "email": {
    "alias": "client",
    "rate_limit": {
      "count": 10,
      "window_days": 1
    }
  },
  "env_try": {
    "scenarios": [
      "try",
      "teams"
    ],
    "merge_scenarios": [
      "try"
    ]
  },
  "budgets": {
    "team": {
      "runs": 30,
      "usd": 20.0
    },
    "roles": {
      "pm": {
        "runs": 4
      },
      "tl": {
        "runs": 6
      },
      "dev": {
        "runs": 14
      },
      "pe": {
        "runs": 8
      },
      "ux": {
        "runs": 8
      }
    },
    "max_cost_usd_per_run": 1.0
  },
  "schedules": {
    "pm": [
      "0 9 * * 1-5",
      "0 15 * * 1-5"
    ],
    "tl": [
      "30 8 * * 1-5"
    ]
  },
  "grant_days": 14,
  "kernel": {
    "socket": "/var/lib/cardea/kernel.sock",
    "spiffe": {
      "socket": "unix:///run/spire/agent.sock",
      "id": "spiffe://cardea.internal/supervisor/dev-team",
      "audience": "cardea-kernel"
    }
  },
  "provisioning": {
    "cardea": [
      "/opt/cardea/apps/api/.venv/bin/python",
      "-I",
      "-m",
      "cardea.service"
    ],
    "config": "/etc/cardea/config.json",
    "base": "/etc/cardea/provision.base.json",
    "out": "/etc/cardea/provision.json"
  }
}
