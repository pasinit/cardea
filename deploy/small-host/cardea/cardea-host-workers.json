{
  "profiles": {
    "session": {
      "memory_mb": 768,
      "cpu_percent": 100,
      "tasks": 256,
      "wall_seconds": 1800,
      "scratch_mb": 256,
      "output_kb": 64,
      "network": {
        "policy": "model_api_only",
        "proxy": "127.0.10.2:3128",
        "hosts": [
          "api.anthropic.com"
        ]
      },
      "jit": true,
      "concurrency": 1,
      "credential": "/etc/cardea/credentials/claude"
    },
    "browser": {
      "memory_mb": 640,
      "cpu_percent": 100,
      "tasks": 256,
      "wall_seconds": 120,
      "scratch_mb": 256,
      "output_kb": 256,
      "network": {
        "policy": "allow_list",
        "proxy": "127.0.10.1:3128",
        "hosts": [
          "www.example.org"
        ]
      },
      "jit": true,
      "concurrency": 1
    },
    "web": {
      "memory_mb": 640,
      "cpu_percent": 100,
      "tasks": 256,
      "wall_seconds": 120,
      "scratch_mb": 256,
      "output_kb": 256,
      "network": {
        "policy": "public_web",
        "proxy": "127.0.10.3:3128"
      },
      "jit": true,
      "concurrency": 1
    },
    "openrouter": {
      "memory_mb": 768,
      "cpu_percent": 100,
      "tasks": 256,
      "wall_seconds": 1800,
      "scratch_mb": 256,
      "output_kb": 64,
      "network": {
        "policy": "model_api_only",
        "proxy": "127.0.10.4:3128",
        "hosts": [
          "openrouter.ai"
        ]
      },
      "jit": true,
      "concurrency": 1,
      "credential": "/etc/cardea/credentials/openrouter"
    },
    "coding": {
      "memory_mb": 4096,
      "cpu_percent": 200,
      "tasks": 512,
      "wall_seconds": 3600,
      "scratch_mb": 4096,
      "output_kb": 14336,
      "network": {
        "policy": "model_api_only",
        "proxy": "127.0.10.5:3128",
        "hosts": [
          "api.anthropic.com"
        ]
      },
      "jit": true,
      "concurrency": 1,
      "credential": "/etc/cardea/credentials/claude-code"
    }
  },
  "workers": {
    "agent": {
      "argv": [
        "/opt/cardea/apps/api/.venv/bin/python",
        "-I",
        "-m",
        "cardea.hosts.session_worker"
      ],
      "profiles": [
        "session"
      ],
      "read_only": [
        "/opt/cardea"
      ],
      "env": {
        "CARDEA_CREDENTIAL_KIND": "oauth_token"
      }
    },
    "browser-open": {
      "argv": [
        "/opt/cardea/apps/api/.venv/bin/python",
        "-I",
        "-m",
        "cardea.hosts.operation_worker",
        "browser.open"
      ],
      "profiles": [
        "browser",
        "web"
      ],
      "read_only": [
        "/opt/cardea",
        "/opt/ms-playwright",
        "/etc/fonts/"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/opt/ms-playwright"
      }
    },
    "opencode": {
      "argv": [
        "/opt/cardea/apps/api/.venv/bin/python",
        "-I",
        "-m",
        "cardea.hosts.session_worker"
      ],
      "profiles": [
        "openrouter"
      ],
      "read_only": [
        "/opt/cardea"
      ],
      "env": {
        "CARDEA_HARNESS_KIND": "opencode",
        "CARDEA_OPENCODE_BINARY": "/opt/cardea/opencode/opencode"
      }
    },
    "code-session": {
      "argv": [
        "/opt/cardea/apps/api/.venv/bin/python",
        "-I",
        "-m",
        "cardea.hosts.operation_worker",
        "coding.code.session"
      ],
      "profiles": [
        "coding"
      ],
      "read_only": [
        "/opt/cardea",
        "/opt/cardea-code"
      ],
      "env": {
        "CARDEA_CODING_CONFIG": "/opt/cardea-code/coding.json"
      }
    }
  }
}
