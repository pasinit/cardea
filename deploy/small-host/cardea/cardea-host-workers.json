{
  "profiles": {
    "session": {
      "memory_mb": 768,
      "cpu_percent": 100,
      "tasks": 256,
      "wall_seconds": 1800,
      "scratch_mb": 256,
      "output_kb": 64,
      "network": {
        "policy": "model_api_only",
        "proxy": "127.0.10.2:3128",
        "hosts": ["api.anthropic.com"]
      },
      "jit": true,
      "concurrency": 1,
      "credential": "/etc/cardea/credentials/claude"
    },
    "browser": {
      "memory_mb": 640,
      "cpu_percent": 100,
      "tasks": 256,
      "wall_seconds": 120,
      "scratch_mb": 256,
      "output_kb": 256,
      "network": {
        "policy": "allow_list",
        "proxy": "127.0.10.1:3128",
        "hosts": ["www.example.org"]
      },
      "jit": true,
      "concurrency": 1
    }
  },
  "workers": {
    "agent": {
      "argv": ["/opt/cardea/apps/api/.venv/bin/python", "-I", "-m", "cardea.hosts.session_worker"],
      "profiles": ["session"],
      "read_only": ["/opt/cardea"],
      "env": {"CARDEA_CREDENTIAL_KIND": "oauth_token"}
    },
    "browser-open": {
      "argv": [
        "/opt/cardea/apps/api/.venv/bin/python", "-I", "-m", "cardea.hosts.operation_worker",
        "browser.open"
      ],
      "profiles": ["browser"],
      "read_only": ["/opt/cardea", "/opt/ms-playwright", "/etc/fonts/"],
      "env": {"PLAYWRIGHT_BROWSERS_PATH": "/opt/ms-playwright"}
    }
  }
}
