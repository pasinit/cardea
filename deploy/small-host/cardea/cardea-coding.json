{
  "repositories": {
    "fixture": {
      "source": "/opt/cardea-code/repos/fixture.git",
      "gates": [
        {
          "name": "lint",
          "argv": [
            "/usr/bin/make",
            "lint"
          ],
          "timeout_seconds": 600
        },
        {
          "name": "typecheck",
          "argv": [
            "/usr/bin/make",
            "typecheck"
          ],
          "timeout_seconds": 600
        },
        {
          "name": "test",
          "argv": [
            "/usr/bin/make",
            "test"
          ],
          "timeout_seconds": 900
        }
      ]
    }
  },
  "harness": {
    "kind": "claude-code",
    "model": "sonnet",
    "credential_kind": "oauth_token",
    "max_turns": 60,
    "max_budget_usd": 5.0,
    "timeout_seconds": 1500
  },
  "gate_env": {
    "UV_CACHE_DIR": "/opt/cardea-code/cache/uv",
    "UV_OFFLINE": "1",
    "UV_NO_SYNC": "1",
    "PIP_NO_INDEX": "1",
    "PIP_FIND_LINKS": "/opt/cardea-code/cache/wheels",
    "NPM_CONFIG_OFFLINE": "true",
    "NPM_CONFIG_CACHE": "/opt/cardea-code/cache/npm"
  }
}
