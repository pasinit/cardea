{
  "tool": {
    "name": "email.send",
    "title": "Email a person outside Cardea",
    "description": "Send one short plain-text email to a recipient alias your role is allowed to write to (for example \"client\"). You name the alias, never an address. A reply, if one comes, arrives in your mailbox as untrusted data on a later run; never wait for it. The same client_key never sends twice. Your role has a small rate limit.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "description": "A recipient alias, such as client."},
        "subject": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n]*$"},
        "body": {"type": "string", "minLength": 1, "maxLength": 8000},
        "client_key": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "required": ["to", "subject", "body", "client_key"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "to": {"type": "string"},
        "thread_id": {"type": "string"},
        "message_id": {"type": "string"},
        "sent_at": {"type": "string"}
      },
      "required": ["to", "thread_id", "message_id", "sent_at"]
    }
  },
  "cardea": {
    "version": 1,
    "effect": "effect",
    "handler": "email.send",
    "timeout_seconds": 60,
    "idempotency_scope": ["/to", "/client_key"],
    "reconciler": "email.find_sent",
    "replies": {
      "poller": "email.poll_replies",
      "interval_seconds": 300,
      "window_days": 14,
      "inbound": "email.poll_inbound"
    }
  }
}
