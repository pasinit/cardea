{
  "tool": {
    "name": "market.quotes",
    "description": "A quote for an instrument. Fake: in-memory only, no network.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instrument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": []
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "bid": {
          "type": "number"
        },
        "ask": {
          "type": "number"
        }
      }
    }
  },
  "cardea": {
    "version": 1,
    "effect": "read",
    "handler": "reference.market.quotes",
    "timeout_seconds": 10
  }
}
