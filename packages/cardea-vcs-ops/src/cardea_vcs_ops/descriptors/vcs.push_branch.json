{
  "tool": {
    "name": "vcs.push_branch",
    "title": "Push a change to an agent branch",
    "description": "Push the commit of a change bundle (a kernel object) to a branch of an allowed repository, without force. The branch must start with the group's prefix (agent/<group>/). Needs repo:<alias>.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "branch": {"type": "string", "minLength": 1, "maxLength": 200},
        "change": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {"type": "string"},
            "resource_id": {"type": "string"},
            "version": {"type": "integer", "minimum": 1},
            "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "required": ["namespace", "resource_id", "version", "content_digest"]
        },
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "expected_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      },
      "required": ["repository", "branch", "change", "head"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "repository": {"type": "string"},
        "branch": {"type": "string"},
        "head": {"type": "string"}
      },
      "required": ["repository", "branch", "head"]
    }
  },
  "cardea": {
    "version": 1,
    "effect": "effect",
    "handler": "vcs.push_branch",
    "timeout_seconds": 120,
    "idempotency_scope": ["/repository", "/branch", "/head"],
    "reconciler": "vcs.find_branch",
    "resource": {"grant": "repo", "argument": "/repository"},
    "inputs": ["/change"]
  }
}
