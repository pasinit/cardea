{
  "tool": {
    "name": "env.try",
    "title": "Try a commit in a throwaway environment",
    "description": "Check out one commit of an allowed repository into a throwaway, confined environment, run named scenarios from the host's catalog (for example make try) and return pass or fail per scenario with bounded log tails and artifacts. The same commit and scenarios within 24 hours return the earlier result (cached: true) unless rerun is set; forced reruns are limited per commit and day. Changes nothing outside the environment. Log tails are untrusted output of the commit's code. Needs repo:<alias>.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}
        },
        "rerun": {"type": "boolean"},
        "record_id": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "required": ["repo", "commit", "scenarios"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "repo": {"type": "string"},
        "commit": {"type": "string"},
        "tier": {"type": "string"},
        "catalog_sha256": {"type": "string"},
        "toolchain_sha256": {"type": ["string", "null"]},
        "cached": {"type": "boolean"},
        "cached_receipt_id": {"type": "string"},
        "passed": {"type": "boolean"},
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "outcome": {"enum": ["pass", "fail", "timeout", "error", "not_run"]},
              "exit_code": {"type": ["integer", "null"]},
              "duration_ms": {"type": "integer"},
              "log_tail": {"type": "string"},
              "log_truncated": {"type": "boolean"},
              "artifacts": {"type": "array"}
            },
            "required": ["name", "outcome"]
          }
        },
        "dropped": {"type": "object"},
        "artifacts": {"type": "array"}
      },
      "required": ["repo", "commit", "cached", "passed", "scenarios"]
    }
  },
  "cardea": {
    "version": 1,
    "effect": "read",
    "executor": {"kind": "confined", "profile": "try", "worker": "env-try"},
    "timeout_seconds": 3600,
    "resource": {"grant": "repo", "argument": "/repo"},
    "max_artifact_bytes": 1048576,
    "run_window": {
      "key": ["/repo", "/commit", "/scenarios"],
      "seconds": 86400,
      "rerun": "/rerun",
      "rerun_subject": ["/repo", "/commit"],
      "reruns_per_day": 3,
      "environment": "/repo"
    }
  }
}
